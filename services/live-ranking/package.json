{
  "name": "live-ranking",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:ingest": "node dist/ingest/main.js",
    "start:aggregator": "node dist/aggregator/main.js",
    "start:ingest:dev": "ts-node-dev --respawn --transpile-only src/ingest/main.ts",
    "start:aggregator:dev": "ts-node-dev --respawn --transpile-only src/aggregator/main.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@forge-lab/panel-ui": "^0.1.0",
    "@paikpaik/kafka-forge": "^1.0.4",
    "@paikpaik/node-forge": "^1.0.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
