{
  "name": "payment-gateway",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:app": "node dist/app/main.js",
    "start:fake-pg": "node dist/fake-pg/main.js",
    "start:app:dev": "ts-node-dev --respawn --transpile-only src/app/main.ts",
    "start:fake-pg:dev": "ts-node-dev --respawn --transpile-only src/fake-pg/main.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@forge-lab/panel-ui": "^0.1.0",
    "@paikpaik/node-forge": "^1.0.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "better-sqlite3": "^11.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
