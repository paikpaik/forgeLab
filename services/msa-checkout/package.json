{
  "name": "msa-checkout",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:gateway": "node dist/gateway/main.js",
    "start:orchestrator": "node dist/orchestrator/main.js",
    "start:order-service": "node dist/order-service/main.js",
    "start:inventory-service": "node dist/inventory-service/main.js",
    "start:gateway:dev": "ts-node-dev --respawn --transpile-only src/gateway/main.ts",
    "start:orchestrator:dev": "ts-node-dev --respawn --transpile-only src/orchestrator/main.ts",
    "start:order-service:dev": "ts-node-dev --respawn --transpile-only src/order-service/main.ts",
    "start:inventory-service:dev": "ts-node-dev --respawn --transpile-only src/inventory-service/main.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.9",
    "@grpc/proto-loader": "^0.7.13",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/microservices": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@paikpaik/node-forge": "^1.0.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "better-sqlite3": "^11.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
